<Window x:Class="Mme.App.ChooseAttackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Attack" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}"
        FontFamily="{DynamicResource ThFont}">
  <StackPanel Margin="12">
    <TextBlock Text="Choose Attack" FontWeight="Bold" FontSize="14"
               Foreground="{DynamicResource ThHeader}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

    <RadioButton x:Name="RbOneshot" Content="None (Assume 1-shot Everything)" Margin="0,3"/>

    <RadioButton x:Name="RbWeapon" Content="Equipped Weapon" Margin="0,3"/>
    <StackPanel Orientation="Horizontal" Margin="20,0,0,3">
      <CheckBox x:Name="ChkBash" Content="Bash" Margin="0,0,10,0"/>
      <CheckBox x:Name="ChkSmash" Content="Smash" Margin="0,0,10,0"/>
      <CheckBox x:Name="ChkBackstab" Content="+Backstab"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,3">
      <RadioButton x:Name="RbMa" Content="Martial Arts Attack:" VerticalAlignment="Center"/>
      <ComboBox x:Name="CmbMa" Width="110" Margin="8,0,0,0">
        <ComboBoxItem Content="Punch"/>
        <ComboBoxItem Content="Kick"/>
        <ComboBoxItem Content="Jumpkick"/>
      </ComboBox>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,3">
      <RadioButton x:Name="RbManual" Content="Enter Damage Manually:" VerticalAlignment="Center"/>
      <TextBox x:Name="TxtPhys" Width="56" Margin="8,0,4,0"/>
      <TextBlock Text="Phys" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="TxtSpell" Width="56" Margin="0,0,4,0"/>
      <TextBlock Text="Spell" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,3">
      <RadioButton x:Name="RbLearned" Content="A Learned Spell @ Current Level:" VerticalAlignment="Center"/>
      <ComboBox x:Name="CmbLearned" Width="150" Margin="8,0,0,0"
                DisplayMemberPath="Name" SelectedValuePath="Number"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,3">
      <RadioButton x:Name="RbAnySpell" Content="Any Spell @ Specified Level:" VerticalAlignment="Center"/>
      <ComboBox x:Name="CmbAnySpell" Width="150" Margin="8,0,6,0"
                DisplayMemberPath="Name" SelectedValuePath="Number"/>
      <TextBlock Text="@" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox x:Name="TxtSpellLevel" Width="36"/>
    </StackPanel>

    <CheckBox x:Name="ChkMeditate" Content="Use Meditate" Margin="0,6,0,0"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Continue" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Continue_Click"/>
      <Button Content="Cancel" Width="70" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>

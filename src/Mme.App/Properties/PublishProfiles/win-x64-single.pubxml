<?xml version="1.0" encoding="utf-8"?>
<!--
  MMUD-Mimic release publish profile (the DEFAULT release: framework-dependent).
  dotnet publish src/Mme.App/Mme.App.csproj -c Release -p:PublishProfile=win-x64-single

  - Framework-dependent single file (~5 MB): needs the .NET 8 Desktop Runtime on
    the target (Windows offers to install it on first launch). This is what every
    beta has shipped as; signing reputation is identical either way.
  - IncludeNativeLibrariesForSelfExtract: bundles e_sqlite3.dll INTO the exe so
    the signed artifact is a single file (nothing unsigned gets dropped beside it).
  - EnableCompressionInSingleFile OFF: compressed bundles look like packed
    executables to AV heuristics - keep the exe transparent.
  - Trimming OFF (WPF is not trim-safe). ReadyToRun OFF.
  For a runtime-free build use win-x64-selfcontained.pubxml (or publish.ps1 -SelfContained).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>

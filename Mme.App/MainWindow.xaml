      <GroupBox Header="EQ"
                Visibility="{Binding IsChecked, ElementName=tabEq, Converter={StaticResource BoolToVis}}">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- equip slot combos: ONE straight-down column (the OG layout) -->
          <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
            <TextBlock Text="Hold:" VerticalAlignment="Center" Margin="0,0,4,0"
                       ToolTip="Held slots survive Paste Character"/>
            <Button Content="All" Width="40" Click="EqHoldAll_Click"/>
            <Button Content="None" Width="44" Margin="3,0,0,0" Click="EqHoldNone_Click"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding EquipSlots}"
                        IsEnabled="{Binding HasDatabase}"
                        VerticalAlignment="Top" Margin="0,0,10,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1,8,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Items}"
                            DisplayMemberPath="Name" SelectedValuePath="Number"
                            SelectedValue="{Binding Selected}" MaxDropDownHeight="360"/>
                  <CheckBox Grid.Column="2" Margin="3,0,0,0" VerticalAlignment="Center"
                            IsChecked="{Binding Hold}"
                            ToolTip="Hold: this slot survives Paste Character"/>
                  <Button Grid.Column="3" Content="&gt;" Width="18" Height="18"
                          Margin="3,0,0,0" Padding="0" FontSize="10"
                          Click="EquipJump_Click"
                          ToolTip="Goto item / add to compare"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>

          <!-- computed stat panel (black terminal) + additional weight -->
          <StackPanel Grid.Column="1" VerticalAlignment="Top">
          <Border Background="Black" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="86"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Style="{StaticResource EqLbl}" Text="Encumbrance:"/>
              <TextBlock Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqEncumbrance}" ToolTip="{Binding EqEncumbranceTip}"/>
              <TextBlock Grid.Column="2" Style="{StaticResource EqLbl}" Text="AC / DR:"/>
              <TextBlock Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqAc}" Tag="2" ToolTip="{Binding EqAcTip}"/>

              <TextBlock Grid.Row="1" Style="{StaticResource EqLbl}" Text="HitPoints:"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqHitPoints}" Tag="5" Foreground="{Binding EqHitPointsColor}" ToolTip="{Binding EqHitPointsTip}"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource EqLbl}" Text="HP Regen:"/>
              <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqHpRegen}" Tag="16" Foreground="{Binding EqHpRegenColor}" ToolTip="{Binding EqHpRegenTip}"/>

              <TextBlock Grid.Row="2" Style="{StaticResource EqLbl}" Text="Mana:"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqMana}" Tag="6" Foreground="{Binding EqManaColor}" ToolTip="{Binding EqManaTip}"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Mana Regen:"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqManaRegen}" Tag="17" Foreground="{Binding EqManaRegenColor}" ToolTip="{Binding EqManaRegenTip}"/>

              <TextBlock Grid.Row="3" Style="{StaticResource EqLbl}" Text="Crits:"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqCrits}" Tag="7" Foreground="{Binding EqCritsColor}" ToolTip="{Binding EqCritsTip}"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Max Damage:"/>
              <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqMaxDmg}" Tag="11" Foreground="{Binding EqMaxDmgColor}" ToolTip="{Binding EqMaxDmgTip}"/>

              <TextBlock Grid.Row="4" Style="{StaticResource EqLbl}" Text="Dodge:"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource EqVal}"
                         Text="{Binding EqDodge}" Tag="8" Foreground="{Binding EqDodgeColor}"
                         ToolTip="{Binding EqDodgeTip}"/>
              <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Min Damage:"/>
              <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqMinDmg}" Tag="30" Foreground="{Binding EqMinDmgColor}" ToolTip="{Binding EqMinDmgTip}"/>

              <TextBlock Grid.Row="5" Style="{StaticResource EqLbl}" Text="SpellCast:"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqSpellCast}" Tag="9" Foreground="{Binding EqSpellCastColor}" ToolTip="{Binding EqSpellCastTip}"/>
              <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource EqLbl}" Text="BS Accuracy:"/>
              <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqBsAccy}" Tag="13" Foreground="{Binding EqBsAccyColor}" ToolTip="{Binding EqBsAccyTip}"/>

              <TextBlock Grid.Row="6" Style="{StaticResource EqLbl}" Text="Accuracy:"/>
              <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource EqVal}"
                         Text="{Binding EqAccuracy}" Tag="10" Foreground="{Binding EqAccuracyColor}"
                         ToolTip="{Binding EqAccuracyTip}"/>
              <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource EqLbl}" Text="BS Min Damage:"/>
              <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqBsMin}" Tag="14" Foreground="{Binding EqBsMinColor}" ToolTip="{Binding EqBsMinTip}"/>

              <TextBlock Grid.Row="7" Style="{StaticResource EqLbl}" Text="Stealth:"/>
              <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqStealth}" Tag="19" Foreground="{Binding EqStealthColor}" ToolTip="{Binding EqStealthTip}"/>
              <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource EqLbl}" Text="BS Max Damage:"/>
              <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqBsMax}" Tag="15" Foreground="{Binding EqBsMaxColor}" ToolTip="{Binding EqBsMaxTip}"/>

              <TextBlock Grid.Row="8" Style="{StaticResource EqLbl}" Text="Quickness:"/>
              <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqQuickness}" Tag="31" Foreground="{Binding EqQuicknessColor}"/>
              <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Hit Magic:"/>
              <TextBlock Grid.Row="8" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqHitMagic}" Tag="12" Foreground="{Binding EqHitMagicColor}" ToolTip="{Binding EqHitMagicTip}"/>

              <TextBlock Grid.Row="9" Style="{StaticResource EqLbl}" Text="Magic Res:"/>
              <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqMr}" Tag="24" Foreground="{Binding EqMrColor}" ToolTip="{Binding EqMrTip}"/>
              <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Perception:"/>
              <TextBlock Grid.Row="9" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqPerception}" Tag="18" Foreground="{Binding EqPerceptionColor}" ToolTip="{Binding EqPerceptionTip}"/>

              <TextBlock Grid.Row="10" Style="{StaticResource EqLbl}" Text="Walk Speed:"/>
              <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqWalkSpeed}"/>
              <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource EqLbl}" Text="Bless Mana:"/>
              <TextBlock Grid.Row="10" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqBlessMana}"/>

              <TextBlock Grid.Row="11" Style="{StaticResource EqLbl}" Text="Attk:"/>
              <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3"
                         Style="{StaticResource EqVal}" Foreground="{DynamicResource ThWarnOrange}"
                         Text="{Binding EqAttack}" Tag="46"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox Content="Use Additional Weight:"
                      IsChecked="{Binding UseAddWeight}"
                      VerticalAlignment="Center"
                      ToolTip="Adds extra carried weight (beyond worn equipment) into the encumbrance used for swing speed and Quick &amp; Deadly. Paste Character fills this from your in-game Encumbrance line."/>
            <TextBox Width="64" Margin="6,0,0,0" FontSize="11"
                     Text="{Binding AddWeight, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
            <Border Background="Black" Padding="8" HorizontalAlignment="Left">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="55"/>
                  <ColumnDefinition Width="55"/><ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource EqLbl}" Text="Punch"/>
                <TextBlock Grid.Column="2" Style="{StaticResource EqLbl}" Text="Kick"/>
                <TextBlock Grid.Column="3" Style="{StaticResource EqLbl}" Text="JmpKck"/>
                <TextBlock Grid.Row="1" Style="{StaticResource EqLbl}" Text="Skill"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqMaSkillPunch}" Tag="37"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource EqVal}" Text="{Binding EqMaSkillKick}" Tag="38"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqMaSkillJk}" Tag="39"/>
                <TextBlock Grid.Row="2" Style="{StaticResource EqLbl}" Text="DMG"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqMaDmgPunch}" Tag="34"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource EqVal}" Text="{Binding EqMaDmgKick}" Tag="35"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqMaDmgJk}" Tag="36"/>
                <TextBlock Grid.Row="3" Style="{StaticResource EqLbl}" Text="Accy"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource EqVal}" Text="{Binding EqMaAccyPunch}" Tag="40"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource EqVal}" Text="{Binding EqMaAccyKick}" Tag="41"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource EqVal}" Text="{Binding EqMaAccyJk}" Tag="42"/>
              </Grid>
            </Border>
            <TextBlock Margin="2,10,0,2" FontWeight="Bold" Text="Carried Items"/>
            <ItemsControl ItemsSource="{Binding CarriedRows}"
                          IsEnabled="{Binding HasDatabase}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                    <TextBox Width="58" Text="{Binding Number, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Item number"/>
                    <TextBlock Width="170" Margin="4,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="x" Margin="2,0,2,0" VerticalAlignment="Center"/>
                    <TextBox Width="34" Text="{Binding Qty, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Width="46" Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Enc}" ToolTip="Encumbrance" Foreground="{DynamicResource ThHelper}"/>
                    <TextBlock Width="28" VerticalAlignment="Center"
                               Text="{Binding Usable}" ToolTip="Usable by character"/>
                    <TextBlock Width="150" VerticalAlignment="Center"
                               Text="{Binding Value}" ToolTip="Best shop price: buy / sell (charm-adjusted)"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Width="60" VerticalAlignment="Center" Foreground="{DynamicResource ThHelper}"
                               Text="{Binding Shop}" ToolTip="Best shop number (+N more shops)"/>
                    <Button Content="✕" Width="22" Margin="4,0,0,0" Padding="0"
                            Click="RemoveCarried_Click"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="2,10,0,2" FontWeight="Bold" Text="Find Best"/>
            <StackPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding FindBestCriteria}"
                        SelectedItem="{Binding SelectedCriterion}" Width="150"
                        DisplayMemberPath="Label" MaxDropDownHeight="400"
                        IsEnabled="{Binding HasDatabase}"/>
              <Button Content="Find Best" Width="76" Margin="6,0,0,0"
                      Click="FindBest_Click" IsEnabled="{Binding HasDatabase}"/>
              <Button Content="Next Best" Width="76" Margin="6,0,0,0"
                      Click="NextBest_Click" IsEnabled="{Binding HasDatabase}"/>
            </StackPanel>
            <CheckBox Content="No limited items" Margin="2,3,0,0"
                      IsChecked="{Binding NoLimitedItems}"/>
            <TextBlock Margin="2,1,0,0" Foreground="{DynamicResource ThHelper}" FontSize="10"
                       TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"
                       Text="Best fills every unheld slot; Next Best steps down through alternatives for the same criterion."/>

            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <Button Content="Add carried item" Width="130"
                      Click="AddCarried_Click" IsEnabled="{Binding HasDatabase}"/>
              <Button Content="Copy EQ/Stats to Clipboard" Width="170" Margin="8,0,0,0"
                      Click="CopyEqStats_Click" IsEnabled="{Binding HasDatabase}"/>
            </StackPanel>


            <TextBlock Margin="2,4,0,2" FontWeight="Bold" Text="Manual Adjustments"/>
            <TextBox Width="300" HorizontalAlignment="Left"
                     Text="{Binding ManualAdjustments, UpdateSourceTrigger=LostFocus}"
                     ToolTip="slot:value pairs, e.g. 2:10, 8:5  (AC/DR values are tenths)"/>
            <TextBlock Margin="2,1,0,0" Foreground="{DynamicResource ThHelper}" FontSize="10"
                       TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"
                       Text="slot:value pairs — 2 AC(tenths), 3 DR(tenths), 7 crits, 8 dodge, 10 accy, 24 MR…"/>

            <TextBlock Margin="2,10,0,0" Foreground="{DynamicResource ThHelper}" TextWrapping="Wrap" MaxWidth="400"
                       Text="Attk shows current attack mode vs a 50-MR target, like the original. Item picker dropdown for carried items is a later polish pass."/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- ============================= WEAPONS ========================== -->
      <GroupBox Header="Weapons"
                Visibility="{Binding IsChecked, ElementName=tabWeapons, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="150" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="1H Blunt" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnShow1HBlunt}"/>
            <CheckBox Content="2H Blunt" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnShow2HBlunt}"/>
            <CheckBox Content="1H Sharp" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnShow1HSharp}"/>
            <CheckBox Content="2H Sharp" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnShow2HSharp}"/>
            <CheckBox Content="Non-Magic" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnNonMagicOnly}"/>
            <CheckBox Content="BS-able" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnBsOnly}"/>
            <CheckBox Content="Limiteds" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding WpnShowLimiteds}"
                      ToolTip="Unchecked hides limited-quantity items"/>
            <TextBlock Text="Speed &lt;=" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <TextBox Width="44" Text="{Binding WpnMaxSpeed, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = off"/>
            <TextBlock Text="STR &lt;=" Margin="8,0,4,0" VerticalAlignment="Center"/>
            <TextBox Width="44" Text="{Binding WpnMaxStr, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = off"/>

            <TextBlock Text="Ability:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <ComboBox Width="150" ItemsSource="{Binding AbilityChoices}"
                      DisplayMemberPath="Name" SelectedValuePath="Num"
                      SelectedValue="{Binding WeaponAbility}"/>
            <ComboBox Width="46" Margin="3,0,0,0" ItemsSource="{Binding AbilityOpChoices}"
                      SelectedIndex="{Binding WeaponAbilityOp}"/>
            <TextBox Width="44" Margin="3,0,0,0"
                     Text="{Binding WeaponAbilityVal, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding WeaponRows}"
                    x:Name="GridWeapons" SelectedItem="{Binding SelectedWeapon}"
                    ContextMenu="{StaticResource ItemsCtxMenu}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
              <DataGridTemplateColumn Header="Edge" Width="46"
                                      SortMemberPath="WeaponKind">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Path Data="{Binding WeaponKind, Converter={StaticResource WeaponGeo}}"
                          Fill="{DynamicResource ThGridFg}" Stretch="Uniform"
                          Width="15" Height="15" HorizontalAlignment="Center"
                          ToolTip="{Binding WeaponKind}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="68"/>
              <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="42"/>
              <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="42"/>
              <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="52"/>
              <DataGridTextColumn Header="LVL" Binding="{Binding Lvl}" Width="42"/>
              <DataGridTextColumn Header="Str" Binding="{Binding Str}" Width="42"/>
              <DataGridTextColumn Header="Enc" Binding="{Binding Enc}" Width="48"/>
              <DataGridTextColumn Header="AC" Binding="{Binding AcDr}" Width="52"/>
              <DataGridTextColumn Header="Acc" Binding="{Binding Acc}" Width="42"/>
              <DataGridTextColumn Header="BS" Binding="{Binding Bs}" Width="42"/>
              <DataGridTextColumn Header="Crits" Binding="{Binding Crits}" Width="46"/>
              <DataGridTextColumn Header="Limit" Binding="{Binding Limit}" Width="46"/>
              <DataGridTextColumn Header="Dmg/Spd" Binding="{Binding DmgSpd, StringFormat=N1}" Width="62"/>
              <DataGridTextColumn Header="#Swings" Binding="{Binding Swings, StringFormat=N2}" Width="62"/>
              <DataGridTextColumn Header="xSwings" Binding="{Binding XSwings}" Width="62"/>
              <DataGridTextColumn Header="Dmg/Rnd" Binding="{Binding DmgRnd}" Width="62"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="2" Style="{StaticResource DetailBox}" Margin="0,3,0,0"
                   Text="{Binding WeaponDetailText, Mode=OneWay}"
                   MouseDoubleClick="DetailText_MouseDoubleClick"/>
        </Grid>
      </GroupBox>

      <!-- ============================= ARMOUR =========================== -->
      <GroupBox Header="Armour"
                Visibility="{Binding IsChecked, ElementName=tabArmour, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="150" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Worn On:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <ComboBox Width="100" ItemsSource="{Binding ArmWornChoices}"
                      SelectedItem="{Binding ArmWornFilter}" ToolTip="Blank = all slots"/>
            <CheckBox Content="Natural" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowNatural}"/>
            <CheckBox Content="Silk" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowSilk}"/>
            <CheckBox Content="Ninja" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowNinja}"/>
            <CheckBox Content="Leather" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowLeather}"/>
            <CheckBox Content="Chain" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowChain}"/>
            <CheckBox Content="Scale" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowScale}"/>
            <CheckBox Content="Plate" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmShowPlate}"/>
            <CheckBox Content="Non-Magic" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmNonMagicOnly}"/>
            <CheckBox Content="No Limit" Margin="6,0,0,0" VerticalAlignment="Center" IsChecked="{Binding ArmNoLimitOnly}"
                      ToolTip="Show only items without a game limit"/>
            <TextBlock Text="Ability:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <ComboBox Width="150" ItemsSource="{Binding AbilityChoices}"
                      DisplayMemberPath="Name" SelectedValuePath="Num"
                      SelectedValue="{Binding ArmourAbility}"/>
            <ComboBox Width="46" Margin="3,0,0,0" ItemsSource="{Binding AbilityOpChoices}"
                      SelectedIndex="{Binding ArmourAbilityOp}"/>
            <TextBox Width="44" Margin="3,0,0,0"
                     Text="{Binding ArmourAbilityVal, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ArmourRows}"
                    x:Name="GridArmour" SelectedItem="{Binding SelectedArmour}"
                    ContextMenu="{StaticResource ItemsCtxMenu}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
              <DataGridTemplateColumn Header="Slot" Width="44"
                                      SortMemberPath="Worn">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Path Data="{Binding SlotKey, Converter={StaticResource SlotGeo}}"
                          Fill="{DynamicResource ThGridFg}" Stroke="{DynamicResource ThGridFg}"
                          StrokeThickness="0.6" Stretch="Uniform"
                          Width="15" Height="15" HorizontalAlignment="Center"
                          ToolTip="{Binding Worn}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
              <DataGridTextColumn Header="Worn" Binding="{Binding Worn}" Width="72"/>
              <DataGridTextColumn Header="Armr Type" Binding="{Binding ArmrType}" Width="80"/>
              <DataGridTextColumn Header="Level" Binding="{Binding Lvl}" Width="46"/>
              <DataGridTextColumn Header="Enc" Binding="{Binding Enc}" Width="52"/>
              <DataGridTextColumn Header="AC/DR" Binding="{Binding AcDr}" Width="66"/>
              <DataGridTextColumn Header="Acc" Binding="{Binding Acc}" Width="42"/>
              <DataGridTextColumn Header="Crits" Binding="{Binding Crits}" Width="46"/>
              <DataGridTextColumn Header="Limit" Binding="{Binding Limit}" Width="46"/>
              <DataGridTextColumn Header="AC/Enc" Binding="{Binding AcPerEnc}" Width="62"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="2" Style="{StaticResource DetailBox}" Margin="0,3,0,0"
                   Text="{Binding ArmourDetailText, Mode=OneWay}"
                   MouseDoubleClick="DetailText_MouseDoubleClick"/>
        </Grid>
      </GroupBox>

      <!-- ============================= SPELLS =========================== -->
      <GroupBox Header="Spells"
                Visibility="{Binding IsChecked, ElementName=tabSpells, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="130" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Magery:" Margin="10,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="70" ItemsSource="{Binding SpellMageryChoices}"
                      SelectedIndex="{Binding SpellMageryIndex}"/>
            <TextBlock Text="Lvl:" Margin="5,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="52" ItemsSource="{Binding SpellMageryLevelChoices}"
                      SelectedIndex="{Binding SpellMageryLevel}"/>
            <TextBlock Text="Target:" Margin="8,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="78" ItemsSource="{Binding SpellTargetChoices}"
                      SelectedIndex="{Binding SpellTargetIndex}"/>
            <TextBlock Text="Atk Type:" Margin="8,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="96" ItemsSource="{Binding SpellAttackTypeChoices}"
                      SelectedIndex="{Binding SpellAttackTypeIndex}"/>
            <TextBlock Text="Ability:" Margin="8,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding AbilityChoices}"
                      DisplayMemberPath="Name" SelectedValuePath="Num"
                      SelectedValue="{Binding SpellContainsAbility}"/>
            <CheckBox Content="Learnable Only" Margin="10,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding SpellLearnableOnly}"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Spells}" x:Name="GridSpells"
                    SelectedItem="{Binding SelectedSpell}"
                    ContextMenu="{StaticResource SpellsCtxMenu}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Lrn" Binding="{Binding Lrn}" Width="34"/>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
              <DataGridTemplateColumn Header="Element" Width="58"
                                      SortMemberPath="DamageKind">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Path Data="{Binding DamageKind, Converter={StaticResource SpellGeo}}"
                          Fill="{Binding DamageKind, Converter={StaticResource SpellGlyphColor}}"
                          Stroke="{Binding DamageKind, Converter={StaticResource SpellGlyphColor}}"
                          StrokeThickness="1.4" Stretch="Uniform"
                          Width="15" Height="15" HorizontalAlignment="Center"
                          ToolTip="{Binding DamageKind}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190"/>
              <DataGridTextColumn Header="Short" Binding="{Binding Short}" Width="60"/>
              <DataGridTextColumn Header="Magery" Binding="{Binding Magery}" Width="60"/>
              <DataGridTextColumn Header="LVL" Binding="{Binding ReqLevel}" Width="42"/>
              <DataGridTextColumn Header="Mana" Binding="{Binding ManaCost}" Width="48"/>
              <DataGridTextColumn Header="Diff" Binding="{Binding Diff}" Width="42"/>
              <DataGridTextColumn Header="Min" Binding="{Binding MinBase}" Width="42"/>
              <DataGridTextColumn Header="Max" Binding="{Binding MaxBase}" Width="42"/>
              <DataGridTextColumn Header="Dur" Binding="{Binding Dur}" Width="42"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="2" Style="{StaticResource DetailBox}" Margin="0,3,0,0"
                   Text="{Binding SpellDetailText, Mode=OneWay}"/>
        </Grid>
      </GroupBox>

      <!-- ============================ CLASS/RACE ======================== -->
      <GroupBox Header="Classes / Races"
                Visibility="{Binding IsChecked, ElementName=tabClassRace, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DataGrid Grid.Row="0" ItemsSource="{Binding ClassRows}" Margin="0,0,0,3"
                    ContextMenu="{StaticResource ClassesCtxMenu}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="36"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="110"/>
              <DataGridTextColumn Header="Exp" Binding="{Binding ExpPct}" Width="50"/>
              <DataGridTextColumn Header="Weapon" Binding="{Binding Weapon}" Width="92"/>
              <DataGridTextColumn Header="Armour" Binding="{Binding Armour}" Width="80"/>
              <DataGridTextColumn Header="Magic" Binding="{Binding Magic}" Width="66"/>
              <DataGridTextColumn Header="Cmbt" Binding="{Binding Cmbt}" Width="46"/>
              <DataGridTextColumn Header="HP" Binding="{Binding Hp}" Width="46"/>
              <DataGridTextColumn Header="Abilities" Binding="{Binding Abilities}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding RaceRows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="36"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="110"/>
              <DataGridTextColumn Header="Exp" Binding="{Binding ExpPct}" Width="50"/>
              <DataGridTextColumn Header="CP" Binding="{Binding BaseCp}" Width="46"/>
              <DataGridTextColumn Header="Stats (min-max)" Binding="{Binding Stats}" Width="420"/>
              <DataGridTextColumn Header="Abilities" Binding="{Binding Abilities}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </GroupBox>

      <!-- ============================= SUNDRY =========================== -->
      <GroupBox Header="Sundry"
                Visibility="{Binding IsChecked, ElementName=tabSundry, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="180" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
          
            <TextBlock Text="Ability:" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <ComboBox Width="150" ItemsSource="{Binding AbilityChoices}"
                      DisplayMemberPath="Name" SelectedValuePath="Num"
                      SelectedValue="{Binding SundryAbility}"/>
            <ComboBox Width="46" Margin="3,0,0,0" ItemsSource="{Binding AbilityOpChoices}"
                      SelectedIndex="{Binding SundryAbilityOp}"/>
            <TextBox Width="44" Margin="3,0,0,0"
                     Text="{Binding SundryAbilityVal, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding SundryRows}"
                    x:Name="GridSundry" SelectedItem="{Binding SelectedSundry}"
                    ContextMenu="{StaticResource SundriesCtxMenu}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="52"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
              <DataGridTextColumn Header="Enc" Binding="{Binding Enc}" Width="56"/>
              <DataGridTextColumn Header="Limit" Binding="{Binding Limit}" Width="50"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="2" Style="{StaticResource DetailBox}" Margin="0,3,0,0"
                   Text="{Binding SundryDetailText, Mode=OneWay}"
                   MouseDoubleClick="DetailText_MouseDoubleClick"/>
        </Grid>
      </GroupBox>

      <!-- ============================ MONSTERS ========================== -->
      <GroupBox Header="Monsters"
                Visibility="{Binding IsChecked, ElementName=tabMonsters, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="360" MinWidth="220"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,2,3">
            <RadioButton Content="By Mob" VerticalAlignment="Center" GroupName="MonMode"
                         IsChecked="{Binding MonsterByLair, Converter={StaticResource InverseBool}}"/>
            <RadioButton Content="By Lair" Margin="6,0,8,0" VerticalAlignment="Center" GroupName="MonMode"
                         IsChecked="{Binding MonsterByLair}"
                         ToolTip="Lair averages: HP/Damage show the * lair-avg; Exp/Hr and Recovery use the character (or party) profile"/>
            <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="120" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Regen" Margin="10,0,3,0" VerticalAlignment="Center"/>
            <ComboBox Width="46" ItemsSource="{Binding MonRegenOpChoices}"
                      SelectedIndex="{Binding MonRegenOp}"/>
            <TextBox Width="40" Margin="3,0,0,0" Text="{Binding MonRegenVal, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="HP &lt;=" Margin="8,0,3,0" VerticalAlignment="Center"/>
            <TextBox Width="52" Text="{Binding MonHpMax, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="DMG &lt;=" Margin="8,0,3,0" VerticalAlignment="Center"
                       ToolTip="Uses calculated dmg vs char/party when computed (Options menu)"/>
            <TextBox Width="52" Text="{Binding MonDmgMax, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="EXP &gt;=" Margin="8,0,3,0" VerticalAlignment="Center"/>
            <TextBox Width="56" Text="{Binding MonExpMin, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Mag &lt;=" Margin="10,0,3,0" VerticalAlignment="Center"
                      IsChecked="{Binding MonMagFilterOn}"/>
            <TextBox Width="40" Text="{Binding MonMagMax, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="More Filters..." Margin="12,0,0,0" Padding="8,1"
                    Click="MoreFilters_Click"/>
            <Button Content="Clear Filters" Margin="6,0,0,0" Padding="8,1"
                    Click="ClearFilters_Click"
                    ToolTip="Clear the search box and reset all More Filters"/>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding MonsterBrowse}"
                    SelectedItem="{Binding SelectedMonster}" x:Name="GridMonsters"
                    ContextMenu="{StaticResource MonstersCtxMenu}">
            <DataGrid.RowStyle>
              <!-- frmMain :6111 — Show All greys non-matching rows RGB(192,192,192) -->
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DoesNotMatchFilter}" Value="True">
                    <Setter Property="Foreground" Value="#C0C0C0"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="48"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
              <DataGridTextColumn Header="Rgn" Binding="{Binding Rgn}" Width="38"/>
              <DataGridTextColumn Header="Exp" Binding="{Binding Exp, StringFormat=N0}" Width="86"/>
              <DataGridTextColumn Header="HP" Binding="{Binding HpText}" SortMemberPath="Hp" Width="56"/>
              <DataGridTextColumn Header="AC/DR" Binding="{Binding AcDr}" Width="58"/>
              <DataGridTextColumn Header="Dodge" Binding="{Binding Dodge}" Width="50"/>
              <DataGridTextColumn Header="MR" Binding="{Binding Mr}" Width="42"/>
              <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" SortMemberPath="DamageResolved" Width="60"/>
              <DataGridTextColumn Header="Exp/Hr | Exp/(D+H)" Binding="{Binding ExpRateText}" SortMemberPath="ExpHr" Width="96"/>
              <DataGridTextColumn Header="Lair Exp | Rcvry" Binding="{Binding LairExpText}" SortMemberPath="LairExp" Width="82"/>
              <DataGridTextColumn Header="Mag." Binding="{Binding Mag}" Width="42"/>
              <DataGridTextColumn Header="Undead" Binding="{Binding Undead}" Width="52"/>
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Row="1" Grid.Column="1" Width="4"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource ThBorder}"/>
          <Border Grid.Row="1" Grid.Column="2" Margin="4,0,0,0" BorderBrush="{DynamicResource ThBorder}"
                  BorderThickness="1" Background="{DynamicResource ThGridBg}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
              <StackPanel DataContext="{Binding MonsterDossier}">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource DosLbl}" Text="Experience"/>
                  <TextBlock Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding Exp, StringFormat=N0}"/>
                  <TextBlock Grid.Row="1" Style="{StaticResource DosLbl}" Text="Regen Time"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding RegenTime}"/>
                  <TextBlock Grid.Row="2" Style="{StaticResource DosLbl}" Text="Game Limit"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding GameLimit}"/>
                  <TextBlock Grid.Row="3" Style="{StaticResource DosLbl}" Text="Alignment"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Alignment}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource DosVal}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Alignment}" Value="Chaotic Evil">
                            <Setter Property="Foreground" Value="#C05000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Alignment}" Value="Evil">
                            <Setter Property="Foreground" Value="#C00000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Alignment}" Value="Neutral Evil">
                            <Setter Property="Foreground" Value="#C00000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Alignment}" Value="Lawful Evil">
                            <Setter Property="Foreground" Value="#C00000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Alignment}" Value="Good">
                            <Setter Property="Foreground" Value="Green"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Alignment}" Value="Lawful Good">
                            <Setter Property="Foreground" Value="Green"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Row="4" Style="{StaticResource DosLbl}" Text="HPs"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DosVal}" Text="{Binding Hp, StringFormat=N0}"/>
                    <TextBlock Style="{StaticResource DosVal}" Text="{Binding HpRegen, StringFormat=' (Regens: {0})'}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Style="{StaticResource DosLbl}" Text="AC/DR"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding AcDr}"/>
                  <TextBlock Grid.Row="6" Style="{StaticResource DosLbl}" Text="MR"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding Mr}"/>
                  <TextBlock Grid.Row="7" Style="{StaticResource DosLbl}" Text="Follow %"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding FollowPct}"/>
                  <TextBlock Grid.Row="8" Style="{StaticResource DosLbl}" Text="Charm LVL"/>
                  <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource DosVal}" Text="{Binding CharmLvl}"/>
                </Grid>
                <TextBlock Style="{StaticResource DosLbl}" Text="Cash (up to)" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource DosVal}" Text="{Binding Cash}"/>
                <TextBlock Style="{StaticResource DosLbl}" Text="BS Defense" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource DosVal}" Text="{Binding BsDefense}"/>
                <TextBlock Style="{StaticResource DosLbl}" Text="Abilities" Foreground="{DynamicResource ThAccentBlue}" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource DosVal}" Text="{Binding Abilities}" Foreground="{DynamicResource ThAccentBlue}"/>
                <TextBlock Style="{StaticResource DosLbl}" Text="Item Drops" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding Drops}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource DosLbl}" Text="Mob's Attacks" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource DosVal}" Text="{Binding Energy, StringFormat='{}{0} energy/round'}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource DosLbl}" Text="Dmg/Round"/>
                  <TextBlock Style="{StaticResource DosVal}" Foreground="{DynamicResource ThAlignEvil}"
                             Text="{Binding AvgDmg, StringFormat='AVG: {0:N1}'}"/>
                </StackPanel>
                <!-- S45: the verbose attack section (PullMonsterDetail) -->
                <ItemsControl ItemsSource="{Binding DataContext.MonsterAttackLines,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                              Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Background="Transparent"
                            MouseLeftButtonDown="DossierLine_MouseDown">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                   FontSize="11" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource ThGridFg}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="red">
                                  <Setter Property="Foreground" Value="{DynamicResource ThDmgRed}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="purple">
                                  <Setter Property="Foreground" Value="{DynamicResource ThDmgPurple}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="party">
                                  <Setter Property="Foreground" Value="{DynamicResource ThDmgParty}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="fear">
                                  <Setter Property="Foreground" Value="{DynamicResource ThUnusableRed}"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="poison">
                                  <Setter Property="Foreground" Value="{DynamicResource ThUsableGreen}"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="confusion">
                                  <Setter Property="Foreground" Value="{DynamicResource ThConfusionOrange}"/>
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="green">
                                  <Setter Property="Foreground" Value="{DynamicResource ThUsableGreen}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="hdr">
                                  <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </GroupBox>

      <!-- ============================== SHOPS =========================== -->
      <GroupBox Header="Shops"
                Visibility="{Binding IsChecked, ElementName=tabShops, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="220"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DataGrid ItemsSource="{Binding ShopRows}" SelectedItem="{Binding SelectedShop}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="4"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource ThBorder}"/>
          <DataGrid Grid.Column="2" Margin="4,0,0,0" ItemsSource="{Binding ShopItemRows}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding ItemNumber}" Width="52"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
              <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="44"/>
              <DataGridTextColumn Header="Regen" Binding="{Binding Regen}" Width="130"/>
              <DataGridTextColumn Header="Cost" Binding="{Binding Cost}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DetailBox}"
                   Height="24" Margin="0,3,0,0" Text="{Binding ShopInfoText, Mode=OneWay}"/>
        </Grid>
      </GroupBox>

      <!-- ============================= EXP/HR =========================== -->
      <GroupBox Header="Exp per Hour (lairs)"
                Visibility="{Binding IsChecked, ElementName=tabExpHr, Converter={StaticResource BoolToVis}}">
        <Grid Margin="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Margin="2">
            <TextBlock Text="Dmg:" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <TextBox Text="{Binding CharDamage}" Width="52"/>
            <TextBlock Text="Spell Dmg:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSpellDamage}" Width="52"/>
            <TextBlock Text="Surprise:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSurpriseDamage}" Width="52"/>
            <TextBlock Text="Surp.Min:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSurpriseMinDamage}" Width="52"/>
            <TextBlock Text="Surp.%:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSurpriseChance}" Width="44"/>
            <TextBlock Text="HP:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharHp}" Width="52"/>
            <TextBlock Text="HP Rgn:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharHpRegen}" Width="46"/>
            <TextBlock Text="Thresh:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharDamageThreshold}" Width="56"/>
          </WrapPanel>
          <WrapPanel Grid.Row="1" Margin="2">
            <TextBlock Text="Attack:" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <ComboBox Width="120" ItemsSource="{Binding AttackModes}"
                      SelectedValue="{Binding AttackMode}"
                      DisplayMemberPath="Label" SelectedValuePath="Mode"/>
            <TextBlock Text="Weapon #:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding AttackWeaponNumber}" Width="52"/>
            <TextBlock Text="Spell #:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <ComboBox ItemsSource="{Binding AttackSpellOptions}"
                      DisplayMemberPath="Name" SelectedValuePath="Number"
                      SelectedValue="{Binding AttackSpellNumber}" Width="170"
                      MaxDropDownHeight="360"
                      ToolTip="Spell (learned mode lists only your pasted/loaded learned spells)"/>
            <TextBlock Text="@Lvl:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding AttackSpellLevel}" Width="38"/>
            <TextBlock Text="MA:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding AttackMartialArts}" Width="28"/>
            <CheckBox Content="Backstab" IsChecked="{Binding AttackBackstab}"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="BS Wpn #:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding AttackBackstabWeapon}" Width="52"/>
            <CheckBox Content="Meditate" IsChecked="{Binding AttackUseMeditate}"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="Spell Cost:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSpellCost}" Width="46"/>
            <TextBlock Text="Ovhd:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharSpellOverhead}" Width="46"/>
            <TextBlock Text="Mana:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharMaxMana}" Width="46"/>
            <TextBlock Text="MP Rgn:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharManaRegen}" Width="40"/>
            <TextBlock Text="Med:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharMeditateRate}" Width="40"/>
            <TextBlock Text="Walk Spd:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding CharWalkSpeed}" Width="46"/>
            <TextBlock Text="Party:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Text="{Binding PartySize}" Width="34"/>
            <TextBlock Text="AC:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <TextBox Width="38" Text="{Binding PartyAc, UpdateSourceTrigger=PropertyChanged}" ToolTip="Party avg AC (0 = default)"/>
            <TextBlock Text="DR:" VerticalAlignment="Center" Margin="5,0,3,0"/>
            <TextBox Width="38" Text="{Binding PartyDr, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="MR:" VerticalAlignment="Center" Margin="5,0,3,0"/>
            <TextBox Width="38" Text="{Binding PartyMr, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = default 50"/>
            <TextBlock Text="Dodge:" VerticalAlignment="Center" Margin="5,0,3,0"/>
            <TextBox Width="38" Text="{Binding PartyDodge, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="#AM:" VerticalAlignment="Center" Margin="5,0,3,0"/>
            <TextBox Width="34" Text="{Binding PartyAntiMagicCount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Party members with anti-magic"/>
            <CheckBox Content="ExpMulti" IsChecked="{Binding UseExpMulti}"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
            <CheckBox Content="Use Character" IsChecked="{Binding UseCharacter}"
                      FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </WrapPanel>
          <WrapPanel Grid.Row="2" Margin="2">
            <CheckBox Content="GMUD" IsChecked="{Binding GreaterMud}"/>
            <CheckBox Content="A" IsChecked="{Binding ModelA}" Margin="8,0,0,0"/>
            <CheckBox Content="B" IsChecked="{Binding ModelB}" Margin="4,0,0,0"/>
            <CheckBox Content="C" IsChecked="{Binding ModelC}" Margin="4,0,0,0"/>
            <CheckBox Content="D" IsChecked="{Binding ModelD}" Margin="4,0,0,0"/>
            <Button Content="Recalculate" Click="RecalculateLairs_Click"
                    Padding="10,1" Margin="10,0,0,0"/>
          </WrapPanel>
          <DataGrid Grid.Row="3" ItemsSource="{Binding Lairs}" Margin="0,3,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Monsters" Binding="{Binding Group}" Width="220"/>
              <DataGridTextColumn Header="Group" Binding="{Binding GroupIndex}" Width="80"/>
              <DataGridTextColumn Header="Mobs" Binding="{Binding Mobs}" Width="50"/>
              <DataGridTextColumn Header="Lairs" Binding="{Binding Lairs}" Width="50"/>
              <DataGridTextColumn Header="AvgExp" Binding="{Binding AvgExp, StringFormat=N0}" Width="80"/>
              <DataGridTextColumn Header="Delay" Binding="{Binding AvgDelay, StringFormat=N1}" Width="56"/>
              <DataGridTextColumn Header="Walk" Binding="{Binding Walk, StringFormat=N2}" Width="56"/>
              <DataGridTextColumn Header="Exp/Hr" Binding="{Binding ExpPerHour, StringFormat=N0}" Width="88"/>
              <DataGridTextColumn Header="RTC" Binding="{Binding Rtc, StringFormat=N1}" Width="52"/>
              <DataGridTextColumn Header="Recovery" Binding="{Binding Recovery}" Width="180"/>
              <DataGridTextColumn Header="Move" Binding="{Binding Move}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>

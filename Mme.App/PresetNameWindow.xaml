<Window x:Class="Mme.App.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Preset" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}" FontFamily="{DynamicResource ThFont}">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThInputBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThInputFg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ThInputFg}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThLabel}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThBtnBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThBtnFg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="10">
    <TextBlock Text="Preset name:" Margin="0,0,0,4"/>
    <TextBox x:Name="TxtName"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Save" Width="70" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
      <Button Content="Cancel" Width="70" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>

     public IReadOnlyList<DossierLine> MonsterAttackLines =>
         _monsterAttackLines;
 
+    /// <summary>The full verbose dossier flattened to plain text for the
+    /// Monsters grid's right-click "Copy Details" (closes the S44
+    /// row-summary DIVERGENCE: abilities/drops/combat/scripting/lair now
+    /// copy too). Reads the live lines, which the SelectedMonster setter
+    /// keeps in sync with the grid selection — the same contract
+    /// WeaponDetailText uses for its grid.</summary>
+    public string MonsterDetailText => FlattenDossier(_monsterAttackLines);
+
+    /// <summary>Section headers carry their name in Label; detail rows use
+    /// an empty Label with Text; ("","") is a blank spacer. Render headers
+    /// as "Label: Text" (or just Label), continuation rows indented, and
+    /// spacers as blank lines — readable when pasted into Notepad.</summary>
+    public static string FlattenDossier(IReadOnlyList<DossierLine> lines)
+    {
+        var sb = new System.Text.StringBuilder();
+        foreach (var ln in lines)
+        {
+            bool hasL = ln.Label.Length > 0, hasT = ln.Text.Length > 0;
+            if (hasL && hasT) sb.Append(ln.Label).Append(": ").Append(ln.Text);
+            else if (hasL)    sb.Append(ln.Label);
+            else if (hasT)    sb.Append("    ").Append(ln.Text);
+            sb.Append("\r\n");
+        }
+        return sb.ToString().TrimEnd();
+    }
+

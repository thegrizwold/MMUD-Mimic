<Window x:Class="Mme.App.PartyPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste Party (Exp/Hr)" Width="1180" Height="640" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ThHelper}"
               Text="Paste each character's stat and inventory outputs, listed one after another, then click Parse. Any *spell buffs* for dodge and hp regen are not accounted for (they are not on the stat sheet). Edit any cell; the averages row follows. Enter an attack code per member (a / aa / aaa / bs / pu / kick / jk, or a 4-letter spell short like lbol) and click Calc Attacks for DMG / Swings / Spell DMG. Continue writes the averages to the Exp/Hr tab (party size must be > 1)."/>

    <TextBox Grid.Row="1" x:Name="TxtText" Margin="0,6,0,0" AcceptsReturn="True" AcceptsTab="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
      <Button Content="Paste from Clipboard" Width="140" Click="PasteClipboard_Click"/>
      <Button Content="Parse →" Width="90" Margin="8,0,0,0" Click="Parse_Click" FontWeight="Bold"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0"
                 Foreground="{DynamicResource ThHelper}"/>
    </StackPanel>

    <DataGrid Grid.Row="3" x:Name="GridParty" ItemsSource="{Binding Members}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="All" FontSize="12"
              CellEditEnding="GridParty_CellEditEnding">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="26"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
        <DataGridTextColumn Header="Class / Lvl" Binding="{Binding ClassLevel}" IsReadOnly="True" Width="100"/>
        <DataGridTextColumn Header="AC" Binding="{Binding Ac}" Width="42"/>
        <DataGridTextColumn Header="DR" Binding="{Binding Dr}" Width="42"/>
        <DataGridTextColumn Header="MR" Binding="{Binding Mr}" Width="42"/>
        <DataGridTextColumn Header="Dodge" Binding="{Binding Dodge}" Width="48"/>
        <DataGridTextColumn Header="HP" Binding="{Binding Hp}" Width="52"/>
        <DataGridTextColumn Header="Regen" Binding="{Binding Regen}" Width="48"/>
        <DataGridTextColumn Header="Rest" Binding="{Binding Rest}" Width="48"/>
        <DataGridTextColumn Header="Heals" Binding="{Binding Heals}" Width="48"/>
        <DataGridTextColumn Header="DMG" Binding="{Binding Dmg}" Width="52"/>
        <DataGridTextColumn Header="Swings" Binding="{Binding Swings}" Width="52"/>
        <DataGridTextColumn Header="Sp.DMG" Binding="{Binding SpDmg}" Width="56"/>
        <DataGridTextColumn Header="Accy" Binding="{Binding Accy}" Width="48"/>
        <DataGridCheckBoxColumn Header="AM" Binding="{Binding AntiMagic, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
        <DataGridCheckBoxColumn Header="Atk Last" Binding="{Binding AttackedLast, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
        <DataGridTextColumn Header="Attack" Binding="{Binding Attack}" Width="70"/>
        <DataGridTextColumn Header="Note" Binding="{Binding AttackNote}" IsReadOnly="True" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="4" Margin="0,6,0,0" Padding="6,4" BorderThickness="1"
            BorderBrush="{DynamicResource ThGridFg}">
      <WrapPanel>
        <TextBlock FontWeight="Bold" Text="Party averages —  " VerticalAlignment="Center"/>
        <TextBlock Text="{Binding PartyTotal, StringFormat='Party: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgAc, StringFormat='AC: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgDr, StringFormat='DR: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgMr, StringFormat='MR: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgDodge, StringFormat='Dodge: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgHp, StringFormat='HP: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgRegen, StringFormat='Regen: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgRest, StringFormat='Rest: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgHeals, StringFormat='Heals (sum): {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgDmg, StringFormat='DMG: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgSwings, StringFormat='Swings: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgSpDmg, StringFormat='Sp.DMG: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AvgAccy, StringFormat='Accy: {0}'}" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding AmTotal, StringFormat='#AM: {0}'}" Margin="0,0,12,0"/>
      </WrapPanel>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Calc Attacks" Width="110" Margin="0,0,8,0" Click="CalcAttacks_Click"
              ToolTip="Runs CalculateAttack / CalculateSpellCast for every member with an attack code"/>
      <Button Content="Continue" Width="100" Margin="0,0,8,0" Click="Continue_Click" FontWeight="Bold"
              ToolTip="Write the averages to the Exp/Hr tab and recalculate"/>
      <Button Content="Cancel" Width="90" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>

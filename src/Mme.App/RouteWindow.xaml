<Window x:Class="Mme.App.RouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Route Finder — How do I get to…" Width="860" Height="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}"
        FontFamily="{DynamicResource ThFont}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- from / to -->
    <WrapPanel>
      <TextBlock Text="From" FontWeight="Bold" VerticalAlignment="Center"/>
      <TextBlock Text="Map" VerticalAlignment="Center" Margin="8,0,3,0"/>
      <TextBox x:Name="TxtFromMap" Width="44"/>
      <TextBlock Text="Room" VerticalAlignment="Center" Margin="6,0,3,0"/>
      <TextBox x:Name="TxtFromRoom" Width="58"/>
      <Button Content="use map room" Margin="4,0,0,0" Padding="6,0" Click="UseCurrent_Click"
              ToolTip="Copy the room currently shown on the Rooms tab"/>
      <TextBlock Text="To" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,0,0"/>
      <TextBlock Text="Map" VerticalAlignment="Center" Margin="8,0,3,0"/>
      <TextBox x:Name="TxtToMap" Width="44"/>
      <TextBlock Text="Room" VerticalAlignment="Center" Margin="6,0,3,0"/>
      <TextBox x:Name="TxtToRoom" Width="58" KeyDown="To_KeyDown"/>
      <TextBlock Text="or name:" VerticalAlignment="Center" Margin="8,0,3,0"/>
      <TextBox x:Name="TxtToName" Width="160" KeyDown="ToName_KeyDown"
               ToolTip="Room name search (first match) — Enter to resolve"/>
      <Button Content="Swap" Width="50" Margin="8,0,0,0" Click="Swap_Click"/>
      <Button Content="Route" Width="70" Margin="8,0,0,0" FontWeight="Bold" Click="Route_Click" IsDefault="True"/>
    </WrapPanel>

    <!-- options -->
    <WrapPanel Grid.Row="1" Margin="0,6,0,0">
      <TextBlock Text="Allow:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <CheckBox Content="Doors" Margin="0,0,10,0" IsChecked="{Binding PathAllowDoors}"/>
      <CheckBox Content="Hidden (search)" Margin="0,0,10,0" IsChecked="{Binding PathAllowHidden}"/>
      <CheckBox Content="Action-gated" Margin="0,0,10,0" IsChecked="{Binding PathAllowActions}"/>
      <CheckBox Content="Text commands" Margin="0,0,10,0" IsChecked="{Binding PathAllowText}"/>
      <CheckBox Content="Traps" Margin="0,0,10,0" IsChecked="{Binding PathAllowTraps}"/>
      <CheckBox Content="Tolls" Margin="0,0,10,0" IsChecked="{Binding PathAllowTolls}"/>
      <CheckBox Content="Map changes" Margin="0,0,10,0" IsChecked="{Binding PathAllowMapChanges}"/>
      <CheckBox Content="Ignore locks (plan, get keys later)" Margin="0,0,10,0" IsChecked="{Binding PathIgnoreLocks}"/>
      <TextBlock x:Name="LblTraveler" Foreground="{DynamicResource ThHelper}" VerticalAlignment="Center" Margin="10,0,0,0"/>
    </WrapPanel>

    <TextBlock Grid.Row="2" x:Name="LblSummary" Margin="0,8,0,4" TextWrapping="Wrap" FontWeight="SemiBold"/>

    <!-- results -->
    <TabControl Grid.Row="3" x:Name="Tabs">
      <TabItem Header="Steps">
        <DataGrid x:Name="GridSteps" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12"
                  MouseDoubleClick="GridSteps_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding N}" Width="40"/>
            <DataGridTextColumn Header="Go" Binding="{Binding Direction}" Width="44"/>
            <DataGridTextColumn Header="From" Binding="{Binding FromName}" Width="200"/>
            <DataGridTextColumn Header="To" Binding="{Binding ToName}" Width="200"/>
            <DataGridTextColumn Header="Map/Room" Binding="{Binding Where}" Width="80"/>
            <DataGridTextColumn Header="Do" Binding="{Binding Note}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Blockers / Why" x:Name="TabWhy">
        <TextBox x:Name="TxtWhy" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                 MouseDoubleClick="TxtWhy_MouseDoubleClick"/>
      </TabItem>
      <TabItem Header="Directions (text)">
        <TextBox x:Name="TxtDirections" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
      </TabItem>
      <TabItem Header="MegaMUD .mp">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,4">
            <TextBlock Text="Author:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtAuthor" Width="120" Margin="4,0,0,0" Text="MMUD-Mimic" TextChanged="Author_TextChanged"/>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThHelper}"
                       Text="Start/end room codes are FFFF (unknown to MegaMUD) — MegaMUD's Paths → Add will add new rooms. Edit the two [CODE:GROUP:NAME] lines if the rooms already exist in your rooms.md."/>
          </WrapPanel>
          <TextBox x:Name="TxtMega" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </DockPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Show destination on map" Width="170" Click="ShowDest_Click"/>
      <Button Content="Copy directions" Width="120" Margin="6,0,0,0" Click="CopyDirections_Click"/>
      <Button Content="Save .mp…" Width="90" Margin="6,0,0,0" Click="SaveMp_Click"/>
      <Button Content="Close" Width="70" Margin="6,0,0,0" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>

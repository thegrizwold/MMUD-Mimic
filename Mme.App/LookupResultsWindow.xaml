<Window x:Class="Mme.App.LookupResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Results" Width="460" Height="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}"
        FontFamily="{DynamicResource ThFont}">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="LblCaption" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
    <ListBox Grid.Row="1" x:Name="LstResults" FontFamily="Consolas" FontSize="12"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,6,0,0">
      <Button Content="Copy All" Width="76" Click="Copy_Click"/>
      <Button Content="Close" Width="70" Margin="6,0,0,0" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="Mme.App.BsCalcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backstab Calculator" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}"
        FontFamily="{DynamicResource ThFont}">
  <StackPanel Margin="10">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock Text="Weapon:" Width="70" VerticalAlignment="Center"/>
      <ComboBox Width="250" ItemsSource="{Binding Weapons}" DisplayMemberPath="Name"
                SelectedValuePath="Number" SelectedValue="{Binding WeaponNumber}"
                MaxDropDownHeight="380"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
      <TextBlock Text="Level:" Width="70" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="Stealth:" Margin="10,0,4,0" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding Stealth, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="STR:" Margin="10,0,4,0" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding Strength, UpdateSourceTrigger=PropertyChanged}"/>
      <CheckBox Content="Class Stealth" Margin="12,0,0,0" VerticalAlignment="Center"
                IsChecked="{Binding ClassStealth}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="+BS Min:" Width="70" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding PlusBsMin, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="+BS Max:" Margin="10,0,4,0" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding PlusBsMax, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="+Max Dmg:" Margin="10,0,4,0" VerticalAlignment="Center"/>
      <TextBox Width="48" Text="{Binding PlusMaxDmg, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <TextBlock Text="Backstab Damage:" FontWeight="Bold"/>
    <TextBlock Text="{Binding DamageText}" FontSize="15"/>
    <TextBlock Text="{Binding AdjText}" Opacity="0.7" Margin="0,3,0,0"/>
    <Button Content="Close" Width="70" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Close_Click"/>
  </StackPanel>
</Window>

<Window x:Class="Mme.App.PasteCharWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste Character" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBox x:Name="TxtText" AcceptsReturn="True" AcceptsTab="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Paste from Clipboard" Width="140" Margin="0,0,8,0"
              Click="PasteClipboard_Click"/>
      <Button Content="Apply" Width="90" Margin="0,0,8,0" IsDefault="True"
              Click="Apply_Click"/>
      <Button Content="Cancel" Width="90" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>

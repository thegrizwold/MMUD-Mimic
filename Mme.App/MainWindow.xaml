<Window x:Class="Mme.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mme.App"
        xmlns:data="clr-namespace:Mme.Data;assembly=Mme.Data"
        Title="MMUD Explorer" Icon="app-icon.png" Width="1280" Height="760"
        PreviewKeyDown="Window_TabHotkeys"
        FontFamily="{DynamicResource ThFont}" FontSize="{DynamicResource ThFontSize}"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThLabel}"
        MinWidth="1024" MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:InverseBoolConverter x:Key="InverseBool"/>
    <local:SpellKindGeometryConverter x:Key="SpellGeo"/>
    <local:SpellKindStrokeConverter x:Key="SpellStroke"/>
    <local:SpellKindColorConverter x:Key="SpellGlyphColor"/>
    <local:WeaponKindGeometryConverter x:Key="WeaponGeo"/>
    <local:SlotGeometryConverter x:Key="SlotGeo"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>


    <Style x:Key="DetailBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Background" Value="{DynamicResource ThGridBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThGridFg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThBorder}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- black terminal stat rows (EQ panel) -->
    <Style x:Key="EqLbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#00C8C8"/>
      <Setter Property="FontFamily" Value="Courier New"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="8,1,4,1"/>
    </Style>
    <Style x:Key="EqVal" TargetType="TextBlock">
      <EventSetter Event="MouseUp" Handler="EqStat_MouseUp"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#00E000"/>
      <Setter Property="FontFamily" Value="Courier New"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,1,10,1"/>
    </Style>

    <Style x:Key="DosLbl" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,1,8,1"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="DosVal" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,1,0,1"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- VB6 mnuItemsPopUp — Weapons/Armour/Sundry/Item Manager grids.
         (Calculate Swings / BS Damage await their windows; census.) -->
    <ContextMenu x:Key="ItemsCtxMenu">
      <MenuItem Header="Equip / Unequip Item" Click="CtxEquip_Click"/>
      <MenuItem Header="Add to Compare" Click="CtxAddCompare_Click"/>
      <MenuItem Header="Add All to Compare" Click="CtxAddAllCompare_Click"/>
      <Separator/>
      <MenuItem Header="Copy Name(s) to Clipboard" Click="CtxCopyNames_Click"/>
      <MenuItem Header="Copy Details to Clipboard" Click="CtxCopyDetails_Click"/>
      <Separator/>
      <MenuItem Header="Set Combat Backstab Weapon" Click="CtxSetBsWeapon_Click"/>
      <MenuItem Header="Add to Item Manager" Click="CtxAddIm_Click"/>
      <Separator/>
      <MenuItem Header="Calc Swings" Click="CtxCalcSwings_Click"/>
      <MenuItem Header="Calc Backstab" Click="CtxCalcBs_Click"/>
    </ContextMenu>

    <!-- VB6 mnuSpellsPopUp ("What casts this?" / counters: census). -->
    <ContextMenu x:Key="SpellsCtxMenu">
      <MenuItem Header="What Casts This?" Click="CtxWhatCasts_Click"/>
      <Separator/>
      <MenuItem Header="Mark/Unmark Spell as Learned" Click="CtxToggleLearned_Click"/>
      <MenuItem Header="Set as Combat Attack/Heal Spell" Click="CtxSetCombatSpell_Click"/>
      <MenuItem Header="Set as Bless Spell" Click="CtxSetBless_Click"/>
      <Separator/>
      <MenuItem Header="Add to Compare" Click="CtxAddCompare_Click"/>
      <MenuItem Header="Add All to Compare" Click="CtxAddAllCompare_Click"/>
      <Separator/>
      <MenuItem Header="Copy Name(s) to Clipboard" Click="CtxCopyNames_Click"/>
      <MenuItem Header="Copy Details to Clipboard" Click="CtxCopyDetails_Click"/>
    </ContextMenu>

    <!-- VB6 mnuAuxPopUp subset (summon lookup / hit calc: census). -->
    <ContextMenu x:Key="ClassesCtxMenu">
      <MenuItem Header="View Spellbook" Click="CtxViewSpellbook_Click"/>
      <MenuItem Header="Copy Name(s) to Clipboard" Click="CtxCopyNames_Click"/>
    </ContextMenu>

    <ContextMenu x:Key="SundriesCtxMenu">
      <MenuItem Header="View Chest Contents" Click="CtxChestContents_Click"/>
      <MenuItem Header="Copy Chest to Clipboard" Click="CtxChestCopy_Click"/>
      <Separator/>
      <MenuItem Header="Copy Name(s) to Clipboard" Click="CtxCopyNames_Click"/>
      <MenuItem Header="Copy Details to Clipboard" Click="CtxCopyDetails_Click"/>
    </ContextMenu>

    <ContextMenu x:Key="MonstersCtxMenu">
      <MenuItem Header="Where/How is this Monster Summoned?" Click="CtxWhereSummoned_Click"/>
      <MenuItem Header="Hit Calc vs Mob" Click="CtxHitCalcMob_Click"/>
      <MenuItem Header="Attack Simulator" Click="CtxAttackSim_Click"/>
      <Separator/>
      <MenuItem Header="Add to Compare" Click="CtxAddCompare_Click"/>
      <MenuItem Header="Add All to Compare" Click="CtxAddAllCompare_Click"/>
      <Separator/>
      <MenuItem Header="Copy Name(s) to Clipboard" Click="CtxCopyNames_Click"/>
      <MenuItem Header="Copy Details to Clipboard" Click="CtxCopyDetails_Click"/>
    </ContextMenu>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open Database..." Click="OpenDatabase_Click"/>
        <Separator/>
        <Separator/>
        <MenuItem Header="_Load Character..." Click="LoadCharacter_Click"/>
        <MenuItem Header="_Paste Character..." Click="PasteCharacter_Click"/>
        <MenuItem Header="_Save Character..." Click="SaveCharacter_Click"/>
        <MenuItem Header="Spell _Book..." Click="SpellBook_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Hit Calculator..." Click="ToolHitCalc_Click"/>
        <MenuItem Header="_Swing Calculator..." Click="ToolSwingCalc_Click"/>
        <MenuItem Header="_Backstab Calculator..." Click="ToolBsCalc_Click"/>
        <MenuItem Header="_Attack Simulator..." Click="ToolAttackSim_Click"/>
        <Separator/>
        <MenuItem Header="_Experience Calculator..." Click="ToolExpCalc_Click"/>
        <MenuItem Header="_Coin Converter..." Click="ToolCoinConvert_Click"/>
        <MenuItem Header="_Notepad..." Click="ToolNotepad_Click"/>
      </MenuItem>
      <MenuItem Header="_Options">
        <MenuItem Header="Only show items that are _In Game"
                  IsCheckable="True" IsChecked="{Binding OnlyInGame}"/>
        <MenuItem Header="GMUD data version &gt; 1.85 (Quick &amp; Deadly /40)"
                  IsCheckable="True" IsChecked="{Binding DatVerModern}"/>
        <MenuItem Header="_Auto-save character on paste"
                  IsCheckable="True" IsChecked="{Binding AutoSaveCharacter}"/>
        <MenuItem Header="_GreaterMUD rules" IsCheckable="True"
                  IsChecked="{Binding GreaterMud}"/>
        <MenuItem Header="Disable _Kai auto-learn" IsCheckable="True"
                  IsChecked="{Binding DisableKaiAutolearn}"/>
        <Separator/>
        <MenuItem Header="_Clear Learned Spells" Click="ClearLearned_Click"/>
        <Separator/>
        <MenuItem Header="Calc Monster Dmg vs C_har" Click="CalcDmgVsChar_Click"
                  ToolTip="Runs the attack simulator for every monster against your calculated AC/DR/MR/Dodge (a few seconds)"/>
        <MenuItem Header="Calc Monster Dmg vs Part_y" Click="CalcDmgVsParty_Click"
                  ToolTip="Uses the party defense boxes on the Exp/Hr tab"/>
        <MenuItem Header="Clear Calculated Monster Dmg" Click="ClearCalcDmg_Click"/>
        <Separator/>
        <MenuItem x:Name="MnuThemeClassic" Header="_Classic Theme"
                  IsCheckable="True" Click="ThemeClassic_Click"/>
        <MenuItem x:Name="MnuThemeDark" Header="_Dark Theme"
                  IsCheckable="True" Click="ThemeDark_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About" IsEnabled="False"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding Status}"/>
    </StatusBar>

    <!-- header: global filter + DB banner -->
    <Grid DockPanel.Dock="Top" Margin="4,2,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Padding="4,0">
        <GroupBox.Header>
          <TextBlock Text="Global Filter + Use Character" Foreground="Green"
                     FontWeight="Bold"/>
        </GroupBox.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="Use Character" IsChecked="{Binding UseCharacter}"
                    VerticalAlignment="Center"/>
          <TextBlock Text="Level:" Margin="10,0,3,0" VerticalAlignment="Center"/>
          <TextBox Text="{Binding CharLevel}" Width="34"/>
          <TextBlock Text="Class:" Margin="10,0,3,0" VerticalAlignment="Center"/>
          <ComboBox Width="120" ItemsSource="{Binding ClassList}"
                    IsEnabled="{Binding HasDatabase}"
                    DisplayMemberPath="Name" SelectedValuePath="Number"
                    SelectedValue="{Binding CharClassNumber}"/>
          <TextBlock Text="Race:" Margin="10,0,3,0" VerticalAlignment="Center"/>
          <ComboBox Width="110" ItemsSource="{Binding RaceList}"
                    IsEnabled="{Binding HasDatabase}"
                    DisplayMemberPath="Name" SelectedValuePath="Number"
                    SelectedValue="{Binding CharRaceNumber}"/>
          <TextBlock Text="Align:" Margin="10,0,3,0" VerticalAlignment="Center"/>
          <ComboBox Width="76" SelectedIndex="{Binding CharAlignment}">
            <ComboBoxItem Content="Any" Foreground="{DynamicResource ThAlignAny}"/>
            <ComboBoxItem Content="Good" Foreground="{DynamicResource ThAlignGood}"/>
            <ComboBoxItem Content="Neutral" Foreground="{DynamicResource ThAlignNeutral}"/>
            <ComboBoxItem Content="Evil" Foreground="{DynamicResource ThAlignEvil}"/>
          </ComboBox>
          <TextBlock Text="Min lvl:" Margin="10,0,3,0" VerticalAlignment="Center"/>
          <TextBox Text="{Binding GlobalMinLevel}" Width="34"/>
          <CheckBox Content="GMUD" IsChecked="{Binding GreaterMud}" Margin="12,0,0,0"
                    VerticalAlignment="Center"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Grid.Column="1" Margin="6,0,0,0" Header="Database Version" Padding="0">
        <TextBlock Text="{Binding Banner}" FontSize="19" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </GroupBox>
    </Grid>

    <!-- tab buttons -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
      <RadioButton x:Name="tabChar" Style="{StaticResource TabBtn}" Content="Char" Width="82"/>
      <RadioButton x:Name="tabCmp" Style="{StaticResource TabBtn}" Content="&lt;-&gt;" Width="48"/>
      <RadioButton x:Name="tabEq" Style="{StaticResource TabBtn}" Content="EQ" Width="70"/>
      <RadioButton x:Name="tabLists" Style="{StaticResource TabBtn}" Content="Lists" Width="70"/>
      <RadioButton x:Name="tabRoomsMap" Style="{StaticResource TabBtn}" Content="Rooms" Width="82"/>
      <RadioButton x:Name="tabWeapons" Style="{StaticResource TabBtn}" Content="Weapons" Width="94"/>
      <RadioButton x:Name="tabArmour" Style="{StaticResource TabBtn}" Content="Armour" Width="90"/>
      <RadioButton x:Name="tabSpells" Style="{StaticResource TabBtn}" Content="Spells" Width="82"/>
      <RadioButton x:Name="tabClassRace" Style="{StaticResource TabBtn}" Content="Class/Race" Width="98"/>
      <RadioButton x:Name="tabSundry" Style="{StaticResource TabBtn}" Content="Sundry" Width="84"/>
      <RadioButton x:Name="tabMonsters" Style="{StaticResource TabBtn}" Content="Monsters" Width="100" IsChecked="True"/>
      <RadioButton x:Name="tabShops" Style="{StaticResource TabBtn}" Content="Shops" Width="82"/>
      <RadioButton x:Name="tabExpHr" Style="{StaticResource TabBtn}" Content="Exp/Hr" Width="88"/>
    </StackPanel>

    <!-- panels -->
    <Grid Margin="4">

      <!-- ============================== CHAR ============================ -->
      <GroupBox Visibility="{Binding IsChecked, ElementName=tabChar, Converter={StaticResource BoolToVis}}">
        <GroupBox.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Character" VerticalAlignment="Center"/>
            <Button Content="Paste Character" Margin="14,0,0,0" Padding="8,1"
                    Click="PasteCharacter_Click"
                    ToolTip="Paste your game output (stat / inventory / spells) to auto-populate"/>
            <TextBox Width="140" Margin="10,0,0,0"
                     Text="{Binding CharName, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Character name (saved in .mmec)"/>
          </StackPanel>
        </GroupBox.Header>
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <GroupBox Grid.Column="0" Header="Stats" Padding="6">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Reload" Width="52" Click="StatsReload_Click" ToolTip="Restore stats from the last paste/load"/>
                <Button Content="Reset" Width="48" Margin="4,0,0,0" Click="StatsReset_Click" ToolTip="Stats to race minimums"/>
                <Button Content="Max" Width="42" Margin="4,0,0,0" Click="StatsMax_Click" ToolTip="Stats to race maximums"/>
                <Button Content="CP" Width="36" Margin="10,0,0,0" Click="CopyCp_Click" ToolTip="Copy CP string to clipboard"/>
                <Button Content="Reset Fields" Width="86" Margin="10,0,0,0" Click="ResetFields_Click"/>
              </StackPanel>
              <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Class:" FontWeight="Bold" Margin="0,3,8,3"/>
              <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ClassList}"
                        DisplayMemberPath="Name" SelectedValuePath="Number"
                        SelectedValue="{Binding CharClassNumber}" Margin="0,2"/>
              <TextBlock Grid.Row="1" Text="Race:" FontWeight="Bold" Margin="0,3,8,3"/>
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RaceList}"
                        DisplayMemberPath="Name" SelectedValuePath="Number"
                        SelectedValue="{Binding CharRaceNumber}" Margin="0,2"/>
              <TextBlock Grid.Row="2" Text="Level:" FontWeight="Bold" Margin="0,3,8,3"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CharLevel}" Width="70"
                       HorizontalAlignment="Left" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Strength:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharStr}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="0"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="0"/>
                <TextBlock Text="{Binding StatRanges[0]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Intellect:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharInt}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="1"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="1"/>
                <TextBlock Text="{Binding StatRanges[1]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="5" Text="Willpower:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharWil}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="2"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="2"/>
                <TextBlock Text="{Binding StatRanges[2]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="6" Text="Agility:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharAgi}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="3"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="3"/>
                <TextBlock Text="{Binding StatRanges[3]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="7" Text="Health:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharHea}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="4"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="4"/>
                <TextBlock Text="{Binding StatRanges[4]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="8" Text="Charm:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharCha}" Width="46" Margin="0,2"/>
                <Button Content="-" Width="20" Margin="3,2,0,2" Click="StatMinus_Click" Tag="5"/>
                <Button Content="+" Width="20" Margin="2,2,0,2" Click="StatPlus_Click" Tag="5"/>
                <TextBlock Text="{Binding StatRanges[5]}" Margin="8,3,0,3" Opacity="0.65" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="9" Text="Quickness:" FontWeight="Bold" Margin="0,3,8,3"/>
              <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding CharQuickness}" Width="46" Margin="0,2"/>
              </StackPanel>
            </Grid>
            </DockPanel>
          </GroupBox>

          <StackPanel Grid.Column="1" Margin="6,0,0,0">
            <GroupBox Header="Hit Points / Hit Point Regen" Padding="6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="HP:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CharHp}" Width="64" Margin="4,0"/>
                <TextBlock Text="Regen:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Text="{Binding CharHpRegen}" Width="52" Margin="4,0"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Spellcasting / Mana / Mana Regen" Padding="6" Margin="0,4,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Spellcasting:" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding CharSpellcasting}" Width="52" Margin="4,0"/>
                  <TextBlock Text="Max Mana:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding CharMaxMana}" Width="52" Margin="4,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Mana Regen:" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding CharManaRegen}" Width="52" Margin="4,0"/>
                  <TextBlock Text="Meditate:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBox Text="{Binding CharMeditateRate}" Width="52" Margin="4,0"/>
                </StackPanel>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Dodge / Crits / Stealth" Padding="6" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dodge:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CharDodge}" Width="46" Margin="4,0"/>
                <TextBlock Text="Crits:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Text="{Binding CharCrit}" Width="46" Margin="4,0"/>
                <TextBlock Text="Stealth:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Text="{Binding CharStealth}" Width="46" Margin="4,0"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Computed (from class/race/level/stats + equipment)">
            <StackPanel Margin="4">
              <TextBlock Text="{Binding CharDerivedHp}" FontWeight="Bold"/>
              <TextBlock Text="{Binding CharDerivedRest}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding CharDerivedMana}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding CharDerivedDodge}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding CharDerivedPicklocks}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding CharDerivedMr}" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <CheckBox Content="Anti-Magic" IsChecked="{Binding CharAntiMagic}"
                            VerticalAlignment="Center"
                            ToolTip="chkCharAntiMagic — feeds the monster attack sim"/>
                  <TextBlock Text="MR Override:" Margin="10,0,4,0" VerticalAlignment="Center"/>
                  <TextBox Width="44" Text="{Binding CharMrOverride, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="0 = use computed MR (txtCharMR)"/>
                </StackPanel>
              <TextBlock Text="{Binding CharDerivedCps}" Margin="0,6,0,0" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ManaRegenNeeded}" Margin="0,4,0,0"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Bless Spells (up to 10 active)">
            <ItemsControl ItemsSource="{Binding BlessSlots}" Margin="4">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ComboBox Margin="0,1,4,1" MinWidth="185"
                            ItemsSource="{Binding Items}"
                            DisplayMemberPath="Name" SelectedValuePath="Number"
                            SelectedValue="{Binding Selected}"
                            MaxDropDownHeight="360"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>

          <GroupBox Header="Completed Quests" Margin="0,4,0,0">
            <StackPanel Margin="4">
<StackPanel IsEnabled="{Binding HasDatabase}">
              <WrapPanel MaxWidth="400">
                <CheckBox Content="Ice Sorceress" Margin="0,1,10,1" IsChecked="{Binding QuestIceSorceress}"/>
                <CheckBox Content="High Druid" Margin="0,1,10,1" IsChecked="{Binding QuestHighDruid}"/>
                <CheckBox Content="Red Dragon" Margin="0,1,10,1" IsChecked="{Binding QuestRedDragon}"/>
                <CheckBox Content="Bishop" Margin="0,1,10,1" IsChecked="{Binding QuestBishop}"/>
                <CheckBox Content="Apparatus" Margin="0,1,10,1" IsChecked="{Binding QuestApparatus}"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox Content="2nd Align" VerticalAlignment="Center" IsChecked="{Binding QuestSecondAlign}"/>
                <ComboBox Width="170" Margin="6,0,0,0" SelectedIndex="{Binding Quest2ndOption}">
                  <ComboBoxItem Content="(nothing)"/>
                  <ComboBoxItem Content="+1 max damage"/>
                  <ComboBoxItem Content="+1 AC, +6 mana"/>
                  <ComboBoxItem Content="+1 SC, +10 mana"/>
                  <ComboBoxItem Content="+4 mana, +6 bs, +1 stealth"/>
                  <ComboBoxItem Content="+10 bs, +2 stealth"/>
                </ComboBox>
              </StackPanel>
              <WrapPanel MaxWidth="400" Margin="0,4,0,0"
                         Visibility="{Binding GreaterMud, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="Opaline" Margin="0,1,10,1" IsChecked="{Binding QuestOpaline}"/>
                <CheckBox Content="Cartographer" Margin="0,1,10,1" IsChecked="{Binding QuestCartographer}"/>
                <CheckBox Content="Loremaster" Margin="0,1,10,1" IsChecked="{Binding QuestLoremaster}"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                          Visibility="{Binding GreaterMud, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="6th Align" VerticalAlignment="Center" IsChecked="{Binding QuestSixthAlign}"/>
                <ComboBox Width="120" Margin="6,0,8,0" SelectedIndex="{Binding Quest6thOption}">
                  <ComboBoxItem Content="(nothing)"/>
                  <ComboBoxItem Content="War/WH/Pal"/>
                  <ComboBoxItem Content="Cleric/Warlock"/>
                  <ComboBoxItem Content="Pri/Mage/Druid"/>
                  <ComboBoxItem Content="Missy/Bard/Gyp"/>
                  <ComboBoxItem Content="Thief/Nin/Ran"/>
                  <ComboBoxItem Content="Mystic"/>
                </ComboBox>
                <CheckBox Content="Dread Wraith" VerticalAlignment="Center" IsChecked="{Binding QuestDreadWraith}"/>
                <ComboBox Width="100" Margin="6,0,0,0" SelectedIndex="{Binding QuestDreadWraithOption}">
                  <ComboBoxItem Content="(nothing)"/>

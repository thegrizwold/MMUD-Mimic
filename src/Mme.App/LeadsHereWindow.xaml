<Window x:Class="Mme.App.LeadsHereWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leads Here" Width="420" Height="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="LblHeader" Margin="0,0,0,6" TextWrapping="Wrap"/>
    <ListBox Grid.Row="1" x:Name="LstRooms" DisplayMemberPath="Display"
             MouseDoubleClick="LstRooms_MouseDoubleClick"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Go" Width="70" Margin="0,0,8,0" IsDefault="True"
              Click="Go_Click"/>
      <Button Content="Close" Width="70" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
